<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (API 26-30), referenced by
   android:fullBackupContent. allowBackup="false" already disables backup there;
   these excludes keep typing data out of any backup or transfer even if that
   flag is ever flipped. Android 12+ uses data_extraction_rules.xml instead.

   AppDataRulesTest checks that every domain below is excluded.
   See https://developer.android.com/identity/data/autobackup#xml-syntax-android-11
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
