<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+) backup and transfer rules.

   Everything this app stores - writing logs, learned vocabulary, clipboard
   history, snippets, Room databases, shared preferences and files - is typing
   data and must never leave the device. On Android 12+ `allowBackup="false"`
   does not stop device-to-device transfer for apps targeting API 31+, and a
   missing <device-transfer> section means "transfer everything", so both
   sections exclude every domain explicitly.

   AppDataRulesTest checks that each section excludes every domain below.
   See https://developer.android.com/identity/data/autobackup#xml-syntax-android-12
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
